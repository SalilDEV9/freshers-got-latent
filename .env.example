# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
# Use URL-safe alphanumeric or hex characters for this Compose database password.
POSTGRES_PASSWORD=replace_with_a_random_hex_password
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set true for HTTPS deployment; false only for localhost rehearsal.
COOKIE_SECURE=false
