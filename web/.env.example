NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Supabase transaction pooler connection. Never NEXT_PUBLIC. TLS required in production.
DATABASE_URL=
FGL_EVENT_ID=
FGL_SIGNING_KEY_ID=FGL-KEY-01
# PEM as JSON string (including escaped newlines), generated using scripts/generate-ticket-key.mjs
FGL_SIGNING_PRIVATE_KEY_JSON=
# JSON object of key ID to public PEM; keep old keys while their tickets remain valid.
FGL_VERIFY_KEYS_JSON=
# Optional server-only Google Sheets read-only OAuth access token. Refresh externally before sync.
GOOGLE_SHEETS_ACCESS_TOKEN=
# Official URL must be supplied; no guessed account.
NEXT_PUBLIC_INSTAGRAM_URL=
